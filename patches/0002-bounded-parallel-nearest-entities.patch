@@ -0,0 +1,124 @@
+package io.papermc.paper.exactperf;
+
+import java.util.concurrent.ForkJoinPool;
+import java.util.concurrent.RecursiveAction;
+import java.util.concurrent.Semaphore;
+import java.util.concurrent.TimeUnit;
+import java.util.concurrent.atomic.LongAdder;
+
+/** Bounded pure numeric work. Workers never retain entity, world or plugin objects. */
+public final class ParallelDistanceOrder {
+    private ParallelDistanceOrder() {}
+    private static final int WORKERS = Math.max(1, Math.min(4, Runtime.getRuntime().availableProcessors() - 1));
+    private static final Semaphore SLOTS = new Semaphore(2);
+    private static final ForkJoinPool POOL = new ForkJoinPool(WORKERS, pool -> {
+        var thread = ForkJoinPool.defaultForkJoinWorkerThreadFactory.newThread(pool);
+        thread.setName("ExactPerf-Sensor-Math-" + thread.threadId());
+        thread.setDaemon(true);
+        return thread;
+    }, null, false);
+    public static final LongAdder parallelCompleted = new LongAdder();
+    public static final LongAdder fallback = new LongAdder();
+
+    /** Caller keeps its own copy; even a timed-out worker cannot observe future input changes. */
+    public static int[] order(final double[] input, final boolean parallel) {
+        if (!parallel || input.length < 1024 || input.length > 65536 || WORKERS < 2 || !SLOTS.tryAcquire()) {
+            if (parallel) fallback.increment();
+            return sequential(input);
+        }
+        final double[] snapshot;
+        final int[] indexes;
+        final int[] scratch;
+        try {
+            snapshot = input.clone();
+            indexes = indexes(input.length);
+            scratch = new int[input.length];
+        } catch (Throwable failure) {
+            SLOTS.release();
+            throw failure;
+        }
+        final var task = new RecursiveAction() {
+            @Override protected void compute() {
+                try { new Sort(snapshot, indexes, scratch, 0, indexes.length).invoke(); }
+                finally { SLOTS.release(); }
+            }
+        };
+        try {
+            POOL.execute(task);
+        } catch (java.util.concurrent.RejectedExecutionException rejected) {
+            SLOTS.release();
+            fallback.increment();
+            return sequential(input);
+        }
+        try {
+            task.get(2, TimeUnit.MILLISECONDS);
+            parallelCompleted.increment();
+            return indexes;
+        } catch (InterruptedException interrupted) {
+            Thread.currentThread().interrupt();
+        } catch (java.util.concurrent.TimeoutException | java.util.concurrent.ExecutionException failed) {
+            // The abandoned task owns its arrays and permit until it really finishes.
+        }
+        fallback.increment();
+        return sequential(input);
+    }
+
+    public static int[] sequential(final double[] values) {
+        int[] indexes = indexes(values.length);
+        sort(values, indexes, new int[values.length], 0, values.length);
+        return indexes;
+    }
+
+    private static int[] indexes(int size) {
+        int[] result = new int[size];
+        for (int i = 0; i < size; ++i) result[i] = i;
+        return result;
+    }
+
+    private static boolean before(double[] keys, int a, int b) {
+        int compare = Double.compare(keys[a], keys[b]);
+        return compare < 0 || compare == 0 && a < b;
+    }
+
+    private static void sort(double[] keys, int[] indexes, int[] scratch, int lo, int hi) {
+        if (hi - lo < 24) {
+            for (int i = lo + 1; i < hi; ++i) {
+                int value = indexes[i], j = i;
+                while (j > lo && before(keys, value, indexes[j - 1])) {
+                    indexes[j] = indexes[j - 1];
+                    --j;
+                }
+                indexes[j] = value;
+            }
+            return;
+        }
+        int mid = (lo + hi) >>> 1;
+        sort(keys, indexes, scratch, lo, mid);
+        sort(keys, indexes, scratch, mid, hi);
+        merge(keys, indexes, scratch, lo, mid, hi);
+    }
+
+    private static void merge(double[] keys, int[] indexes, int[] scratch, int lo, int mid, int hi) {
+        if (!before(keys, indexes[mid], indexes[mid - 1])) return;
+        int a = lo, b = mid;
+        for (int i = lo; i < hi; ++i) {
+            scratch[i] = b >= hi || a < mid && before(keys, indexes[a], indexes[b]) ? indexes[a++] : indexes[b++];
+        }
+        System.arraycopy(scratch, lo, indexes, lo, hi - lo);
+    }
+
+    private static final class Sort extends RecursiveAction {
+        private final double[] keys;
+        private final int[] indexes, scratch;
+        private final int lo, hi;
+        Sort(double[] keys, int[] indexes, int[] scratch, int lo, int hi) {
+            this.keys = keys; this.indexes = indexes; this.scratch = scratch; this.lo = lo; this.hi = hi;
+        }
+        @Override protected void compute() {
+            if (hi - lo <= 512) { sort(keys, indexes, scratch, lo, hi); return; }
+            int mid = (lo + hi) >>> 1;
+            invokeAll(new Sort(keys, indexes, scratch, lo, mid), new Sort(keys, indexes, scratch, mid, hi));
+            merge(keys, indexes, scratch, lo, mid, hi);
+        }
+    }
+}
