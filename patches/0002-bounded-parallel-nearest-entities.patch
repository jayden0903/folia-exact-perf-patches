@@ -0,0 +1,42 @@
+package io.papermc.paper.exactperf;
+
+import java.util.List;
+import net.minecraft.world.entity.Entity;
+import net.minecraft.world.entity.LivingEntity;
+import net.minecraft.world.phys.Vec3;
+import ca.spottedleaf.moonrise.common.util.TickThread;
+
+/** Capture and publish on the owning region. Original comparator remains the compatibility fallback. */
+public final class ParallelNearestEntities {
+    private ParallelNearestEntities() {}
+    private static final boolean ENABLED = Boolean.getBoolean("exactperf.parallel-sensors");
+    private static final ClassValue<Boolean> DEFAULT_DISTANCE = new ClassValue<>() {
+        @Override protected Boolean computeValue(Class<?> type) {
+            try {
+                return type.getMethod("distanceToSqr", Entity.class).getDeclaringClass() == Entity.class
+                    && type.getMethod("distanceToSqr", Vec3.class).getDeclaringClass() == Entity.class;
+            } catch (ReflectiveOperationException | SecurityException unsupported) { return false; }
+        }
+    };
+    private static final ClassValue<Boolean> DEFAULT_POSITION = new ClassValue<>() {
+        @Override protected Boolean computeValue(Class<?> type) {
+            try { return type.getMethod("position").getDeclaringClass() == Entity.class; }
+            catch (ReflectiveOperationException | SecurityException unsupported) { return false; }
+        }
+    };
+
+    public static boolean sort(final LivingEntity body, final List<LivingEntity> entities) {
+        if (!ENABLED || entities.size() < 1024 || entities.size() > 65536
+            || !DEFAULT_DISTANCE.get(body.getClass()) || !TickThread.isTickThreadFor(body)) return false;
+        // Cross-region entities and plugin overrides retain the exact original call path.
+        for (LivingEntity entity : entities) {
+            if (!DEFAULT_POSITION.get(entity.getClass()) || !TickThread.isTickThreadFor(entity)) return false;
+        }
+        LivingEntity[] references = entities.toArray(LivingEntity[]::new);
+        double[] distances = new double[references.length];
+        for (int i = 0; i < distances.length; ++i) distances[i] = body.distanceToSqr(references[i]);
+        int[] order = ParallelDistanceOrder.order(distances, true);
+        for (int i = 0; i < order.length; ++i) entities.set(i, references[order[i]]);
+        return true;
+    }
+}
